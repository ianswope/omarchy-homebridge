#!/bin/bash

# Sign in to a Homebridge (config-ui-x) server and write the config this plugin
# needs. Unlike the Plex sign-in, config-ui-x issues no long-lived API key —
# only short session tokens — so this stores the username and password to
# refresh them, in a 0600 file outside the plugin directory. Point it at a
# DEDICATED, NON-ADMIN Homebridge user: it can view and control accessories but
# cannot change server settings, so the stored credential is the least it can be.
#
#   omarchy-homebridge-login [config-path]
#
# It asks for the server URL, the username and the password (hidden), verifies
# them against the server, and only writes the file once the login succeeds.

set -o pipefail

CONFIG="${1:-$HOME/.config/omarchy-homebridge/config.json}"
[[ $CONFIG == "~"* ]] && CONFIG="$HOME${CONFIG#\~}"

LOGIN_MAX_BYTES=1048576
DEFAULT_URL="http://homebridge.local:8581"

die() { printf '\n%s\n' "$1" >&2; exit 1; }

CONFIG_LIB="${BASH_SOURCE[0]%/*}/homebridge-config.sh"
source "$CONFIG_LIB" 2>/dev/null || die "Cannot read homebridge-config.sh next to this helper."

command -v jq >/dev/null 2>&1 || die "jq is not installed."
command -v curl >/dev/null 2>&1 || die "curl is not installed."
[[ $CONFIG == /* ]] || die "Config path must be absolute: $CONFIG"

# Read any existing config through the same bounded, no-follow reader the other
# helpers use, so a stale url can be offered as the default. A symlink or an
# oversized file here is said out loud rather than worked around.
existing_json=""
read_rc=0
existing_json=$(read_config_json "$CONFIG") || read_rc=$?
if (( read_rc >= 2 )); then
  die "$(config_read_error "$read_rc" "$CONFIG")
Move it aside and run this again."
fi

prev_url=""
prev_user=""
if [[ -n $existing_json ]] && jq -e . <<<"$existing_json" >/dev/null 2>&1; then
  prev_url=$(jq -r '.url // ""' <<<"$existing_json")
  prev_user=$(jq -r '.username // ""' <<<"$existing_json")
fi

default_url="${prev_url:-$DEFAULT_URL}"

printf 'Sign in to Homebridge\n'
printf '=====================\n\n'
printf 'Use a dedicated non-admin Homebridge user if you can\n'
printf '(Homebridge UI -> Users -> add, with admin off).\n\n'

if [[ ! -t 0 ]]; then
  die "This needs a terminal to type into. Run it from one:
  $(basename "$0") \"$CONFIG\""
fi

printf 'Server URL [%s]: ' "$default_url"
read -r url
[[ -z $url ]] && url="$default_url"
# A bare host is a courtesy: assume http:// so the person does not have to.
[[ $url == http://* || $url == https://* ]] || url="http://$url"
url="${url%/}"
is_http_url "$url" || die "That is not a usable http(s) URL."

printf 'Username%s: ' "${prev_user:+ [$prev_user]}"
read -r user
[[ -z $user && -n $prev_user ]] && user="$prev_user"
[[ -n $user ]] || die "A username is required."

printf 'Password (hidden): '
read -rs pass
printf '\n'
[[ -n $pass ]] || die "A password is required."

printf '\nVerifying with %s ...\n' "$url"
login_json=$(hb_login "$LOGIN_MAX_BYTES" "$url" "$user" "$pass" 15) \
  || die "Sign-in failed. Check the URL, username and password and try again."
token=$(jq -r '.access_token // empty' <<<"$login_json" 2>/dev/null)
is_jwt "$token" || die "The server returned a token with unexpected characters."

# A quick, best-effort look at how many accessories the account can see. Never
# fatal — the credential is already proven — but a friendlier confirmation than
# a bare "signed in", and it proves the token works on the real endpoint too.
count_note=""
acc_tmp=$(mktemp -t omarchy-homebridge-login-acc.XXXXXX) 2>/dev/null
if [[ -n $acc_tmp ]]; then
  if printf 'header = "Authorization: Bearer %s"\nheader = "Accept: application/json"\nurl = "%s/api/accessories"\nmax-time = 15\noutput = "%s"\nsilent\n' \
       "$token" "$url" "$acc_tmp" | curl --config - --max-filesize 2097152 >/dev/null 2>&1; then
    n=$(jq '[.[] | select(.serviceCharacteristics // [] | any(.type == "On" and .canWrite == true))] | length' -- "$acc_tmp" 2>/dev/null)
    [[ $n =~ ^[0-9]+$ ]] && count_note=" It can control $n accessor$([[ $n == 1 ]] && echo y || echo ies)."
  fi
  rm -f -- "$acc_tmp"
fi

mkdir -p "$(dirname -- "$CONFIG")" || die "Cannot create $(dirname -- "$CONFIG")"

# Written to an mktemp file (O_EXCL, 0600) and moved into place, so an
# interrupted write cannot leave a half-written credential and no one can
# pre-plant a symlink at a predictable name to divert it. Existing fields are
# preserved; the token is deliberately dropped so the first poll logs in fresh
# for whatever server we just pointed at.
config_tmp=$(mktemp -- "$(dirname -- "$CONFIG")/.write.XXXXXX") || die "Cannot create a temporary file in $(dirname -- "$CONFIG")"
chmod 600 -- "$config_tmp" 2>/dev/null
trap 'rm -f -- "$config_tmp"' EXIT

if [[ -n $existing_json ]] && jq -e . <<<"$existing_json" >/dev/null 2>&1; then
  jq --arg url "$url" --arg u "$user" --arg p "$pass" \
    '. + {url:$url, username:$u, password:$p} | del(.token, .token_expires)' <<<"$existing_json" > "$config_tmp" \
    || die "Could not write $config_tmp"
else
  jq -n --arg url "$url" --arg u "$user" --arg p "$pass" \
    '{url:$url, username:$u, password:$p}' > "$config_tmp" || die "Could not write $config_tmp"
fi
chmod 600 -- "$config_tmp"
mv -- "$config_tmp" "$CONFIG" || die "Could not write $CONFIG"
trap - EXIT

printf '\nSigned in to %s.%s\n  %s\n\n' "$url" "$count_note" "$CONFIG"
printf 'Now add {"id": "ianswope.homebridge"} to bar.layout (e.g. the right\n'
printf 'section) in ~/.config/omarchy/shell.json, then run: omarchy restart shell\n'
